# Site
NEXT_PUBLIC_SITE_URL=https://www.digitaldude.co.uk

# Supabase — all database access is server-side only (service role key).
# Never expose SUPABASE_SERVICE_ROLE_KEY to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: email notification on new contact submission (Brevo)
BREVO_API_KEY=
CONTACT_NOTIFY_EMAIL=info@digitaldude.co.uk

# Analytics & Verification
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=google-site-verification-token

# Google Calendar & Meet Automation (OAuth2 — service accounts cannot create
# Meet links or invite attendees on a personal, non-Workspace calendar).
# Setup: create an OAuth Client ID (Web application) in Google Cloud Console,
# add GOOGLE_OAUTH_REDIRECT_URI below as an authorized redirect URI, fill in
# the client id/secret/setup key here, restart the app, then visit
# /api/auth/google?key=<GOOGLE_OAUTH_SETUP_KEY> in your own browser while
# logged into the Google account whose calendar should receive bookings.
# Copy the refresh token it shows you into GOOGLE_OAUTH_REFRESH_TOKEN.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_OAUTH_SETUP_KEY=choose-a-random-string
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
NEXT_PUBLIC_GOOGLE_APPOINTMENT_URL=https://calendar.app.google/your-appointment-schedule-id

# Admin & Sales Rep Portal Security
ADMIN_PASSWORD=your-secure-admin-password
REP_AUTH_SECRET=your-random-rep-auth-secret


# ---------------------------------------------------------------------------
# Client Acquisition System (/admin/acquisition) — see docs/acquisition.md
# ---------------------------------------------------------------------------
# REQUIRED. Signs unsubscribe links (>= 32 random chars, e.g. `openssl rand -hex 32`).
# Changing it invalidates every unsubscribe link already sent — treat it as permanent.
ACQ_UNSUBSCRIBE_SECRET=
# Verifies inbound email-provider webhooks (>= 16 chars). Webhooks are rejected without it.
ACQ_WEBHOOK_SECRET=
# Bearer token for /api/acquisition/cron/worker (the existing CRON_SECRET is reused).
CRON_SECRET=
# Name recorded as the approver / reviewer in the audit log.
ACQ_OPERATOR_NAME=Neil
# Hard ceiling on any campaign's daily send limit, whatever is typed in the UI.
ACQ_MAX_DAILY_LIMIT=5
# Brevo sending (initial emails only). Use a dedicated sending SUBDOMAIN, verified in Brevo with its own
# SPF/DKIM/DMARC, so cold-email complaints can never affect booking/login/applicant mail.
# BREVO_API_KEY is the existing key already used by the site.
ACQ_BREVO_SENDER_EMAIL=
# Optional pilot guard: comma-separated emails/domains. When set, ONLY these recipients can be emailed.
ACQ_SEND_ALLOWLIST=
# Calendar booking link offered to interested prospects (falls back to the appointment URL above).
ACQ_BOOKING_URL=

# AI provider — any OpenAI-compatible chat-completions endpoint (free tiers included).
# Leave blank to use the manual research workflow; the CRM never depends on the model.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Daily automatic discovery + research (turn on at /admin/acquisition/settings). Needs the AI_* vars above.
# Discovery uses the official Brave Search API; leave blank to disable discovery (research of existing companies still works).
BRAVE_SEARCH_API_KEY=
# Contact finder (Hunter.io). Can also be saved in the admin UI. Lookups are cached 30 days per company and capped daily.
HUNTER_API_KEY=
ACQ_DAILY_HUNTER_LOOKUPS=25
ACQ_DAILY_SEARCH_QUERIES=5
ACQ_DAILY_NEW_COMPANIES=10
ACQ_DAILY_RESEARCH_LIMIT=15

# Optional Telegram alerts for positive replies and failures.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Reply reading (read-only Gmail API) and admin alerts
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
ADMIN_ALERT_EMAIL=info@digitaldude.co.uk

# Optional: a Reacher (check-if-email-exists) backend you host with outbound port 25 open, for mailbox-level checks
REACHER_URL=
REACHER_SECRET=
