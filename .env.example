# Site
NEXT_PUBLIC_SITE_URL=https://www.digitaldude.co.uk

# Supabase — all database access is server-side only (service role key).
# Never expose SUPABASE_SERVICE_ROLE_KEY to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: email notification on new contact submission (Brevo)
BREVO_API_KEY=
CONTACT_NOTIFY_EMAIL=info@digitaldude.co.uk

# Analytics & Verification
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=google-site-verification-token
